# Local env for LLM-NPC services (repo root, gitignored). See .env.example.
# Everything else (topology, endpoints, ports) now has working code defaults;
# override here only what differs from .env.example.
GATEWAY_AUTH_TOKENS='{"dev-token":{"caller_id":"virtual-game","caller_kind":"GameClient","game_id":"demo_game","allowed_worlds":"Any"}}'

# --- Edge gateway budget ---
# Top-of-chain deadline budget: gateway deadline = now + this, then runtime
# subtracts RUNTIME_LAYER_RESERVE_MS (250) before forwarding to cognition as
# timeout_ms. Default 5000 left cognition only ~4750ms, which a single slow
# deepseek-v4-pro step (~3.7s) plus a second step blows past. Widen so the
# binding cap becomes cognition's wall-clock (COGNITION_BUDGET_WALL_CLOCK_MS).
GATEWAY_HTTP_REQUEST_TIMEOUT_MS=12000

# --- Cognition step budget ---
# Per-turn wall-clock cap for the bounded agent loop. Default 8000 was the real
# limiter after widening the gateway budget: a multi-step deepseek-v4-pro turn
# (~3.7s/step) blows past 8s. Kept below the upstream budget forwarded from
# runtime (gateway 12000 - RUNTIME_LAYER_RESERVE_MS 250 = ~11750) so the loop
# self-bounds without a layer inversion.
COGNITION_BUDGET_WALL_CLOCK_MS=10000

# --- Virtual Game tool (dev client) ---
# Bearer token the tool sends; MUST be a key in GATEWAY_AUTH_TOKENS above,
# otherwise the gateway rejects every request with 401 Unauthenticated.
VG_GATEWAY_AUTH_TOKEN=dev-token
# Per-request HTTP timeout. Default 10000 races cognition's 10s wall-clock
# budget (COGNITION_BUDGET_WALL_CLOCK_MS): a slow deepseek-v4-pro turn
# returning at ~10s gets cut by the client. 20s sits comfortably above the
# gateway's 12s deadline (GATEWAY_HTTP_REQUEST_TIMEOUT_MS) so the client
# never wins the race.
VG_REQUEST_TIMEOUT_MS=20000

# --- retrieval ---
# RETRIEVAL_EMBEDDING_MODEL is REQUIRED (no working default). It is a
# manifest-verification label, NOT the routing key: it is written into the
# artifact manifest at build time and must match at load time. Empty aborts
# startup with `invalid input: embedding_model`. The routing role defaults to
# `retrieval-embed` (RETRIEVAL_EMBEDDING_ROLE); the gateway must define that
# embedding role before `retrieval-index --world <w>` can actually embed.
RETRIEVAL_EMBEDDING_MODEL=text-embedding-3-small

# OpenAI embedding backend for the `retrieval-embed` gateway role. Replace with
# your real key before running `retrieval-index --world <w>`; a placeholder here
# will make the gateway return 401 on the first embed call.
OPENAI_API_KEY=sk-REPLACE_ME

# --- LLM gateway (port 8081) ---
# Config path + DeepSeek chat key for the intent-analysis / decision roles. Both
# are required for llm-gateway to boot: it resolves every backend `key_ref` at
# startup (router.rs), so an unset DEEPSEEK_API_KEY aborts with `MissingSecret`.
# The key below is a placeholder; chat calls 401 until a real key is set, but
# `retrieval-index` only needs the embedding role to answer.
LLM_GATEWAY_CONFIG=./config/llm-gateway/config.json
DEEPSEEK_API_KEY=sk-7258159ce0ac4e51bc9bf7bf17d69637
