# AISE — environment variables (repo root).
#
# Copy this file to `.env` (gitignored). The aise-server binary loads `.env`
# at startup via dotenvy, so variables here override config/server.toml; vars
# already set in the shell take precedence over the file. Empty values are
# treated as "unset" and never clobber config.
#
# A `# VAR=value` line shows the code default — uncomment to override.

# --- Logging -----------------------------------------------------------------
# RUST_LOG=info

# --- Config file --------------------------------------------------------------
# Path to the TOML config. Unset => config/server.toml (repo-relative).
# AISE_CONFIG=config/server.toml

# --- Server -------------------------------------------------------------------
# Listen address.
# AISE_LISTEN_ADDR=127.0.0.1:3000
# Bounded session quota (R-ARCH-04).
# AISE_MAX_SESSIONS=64
# Log output directory (gitignored).
# AISE_TRACE_DIR=trace
# Static frontend directory; empty => aise-server's compiled-in assets.
# AISE_ASSETS_DIR=

# --- Engine: LLM ----------------------------------------------------------------
# OpenAI-compatible endpoint root (Ollama/vLLM/OpenAI...).
# AISE_LLM_BASE_URL=http://localhost:11434/v1
# Sensitive: prefer keeping the real key in `.env`, not in config/server.toml.
# AISE_LLM_API_KEY=
# AISE_LLM_MODEL=qwen2.5
# Shared concurrency budget for all LLM calls (R-CONC-04).
# AISE_LLM_MAX_CONCURRENT=4
# AISE_LLM_TEMPERATURE=0.8

# --- Engine: storage ------------------------------------------------------------
# SQLite database path (repo-relative, lives under data/, gitignored).
# AISE_DB_URL=data/aise.db

# --- Engine: turn budget ---------------------------------------------------------
# Max Validation/Repair loop iterations (R-AISE-06).
# AISE_TURN_MAX_REPAIR_ROUNDS=3
# AISE_TURN_MAX_TOKENS=2048
# AISE_TURN_MAX_RETRIEVED_ITEMS=20
