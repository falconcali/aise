# LLM-NPC — environment variables (repo root).
#
# Copy to `.env` (gitignored). Service binaries and the virtual_game tool load
# this at startup via dotenvy; shell-set vars take precedence. A `# VAR=value`
# line shows the code default — uncomment to override. `tools/dev/start_servers.bat`
# builds and launches the fleet from the repo root (so the relative defaults
# below resolve) and sets none of these itself.

# Shared -----------------------------------------------------------------------
# RUST_LOG=info

# --- Auth: edge gateway ---
# Bearer-token -> AuthContext map (JSON). Unset => every request is
# `Unauthenticated`. The key is what clients send as `Authorization: Bearer`.
#   caller_kind   : DedicatedServer | GameClient | Internal
#   allowed_worlds: "Any" | {"Set":["demo-world", ...]}
#   game_id       : selects config/derivation/<game_id>.yaml in Runtime (non-empty).
GATEWAY_AUTH_TOKENS='{"dev-token":{"caller_id":"virtual-game","caller_kind":"GameClient","game_id":"demo_game","allowed_worlds":"Any"}}'

# --- LLM gateway ---
# Role/backend config (unset => ./llm-gateway.json). listen_addr lives in this
# file, not env (default 127.0.0.1:8081).
LLM_GATEWAY_CONFIG=./config/llm-gateway/config.json
DEEPSEEK_API_KEY=sk-api-key
# Embedding backend for the `retrieval-embed` role (OpenAI text-embedding-3-small,
# 1536-dim). Swap model + endpoint + `embedding_dim` in config/llm-gateway/
# config.json and this key for a domestic OpenAI-compatible provider if needed.
OPENAI_API_KEY=sk-api-key

# --- Service topology (local dev fleet) ---------------------------------------
# Each service: its listen address and the downstream endpoints it dials.
# Defaults form a wired-up fleet; uncomment to move a service to another port.
#
# gateway (HTTP edge)            127.0.0.1:8080
#   GATEWAY_RUNTIME_OWNERS       runtime endpoints to route to (comma-separated).
#   GATEWAY_RUNTIME_OWNERS=http://127.0.0.1:15051
#   GATEWAY_LISTEN_ADDR=127.0.0.1:8080
#   GATEWAY_TRACE_DIR=./trace/gateway
#   GATEWAY_TRACE_LEVEL=standard
#   GATEWAY_HTTP_REQUEST_TIMEOUT_MS=5000  top-of-chain deadline budget. Runtime
#                                          subtracts RUNTIME_LAYER_RESERVE_MS (250)
#                                          before forwarding to cognition; keep it
#                                          above cognition's 8s wall-clock so the
#                                          wall-clock is the real cap for slow
#                                          multi-step (deepseek-v4-flash) turns.
#
# runtime                        127.0.0.1:15051
#   RUNTIME_LISTEN_ADDR=127.0.0.1:15051
#   RUNTIME_COGNITION_ENDPOINT=http://127.0.0.1:15061
#   RUNTIME_MEMORY_WRITE_ENDPOINT=http://127.0.0.1:15071
#   RUNTIME_WORLD_STATE_WRITE_ENDPOINT=http://127.0.0.1:15073
#   RUNTIME_TRACE_DIR=./trace/runtime
#
# cognition (slow brain)         127.0.0.1:15061
#   COGNITION_LISTEN_ADDR=127.0.0.1:15061
#   COGNITION_LLM_ENDPOINT=http://127.0.0.1:8081
#   COGNITION_MEMORY_ENDPOINT=http://127.0.0.1:15071
#   COGNITION_RETRIEVAL_ENDPOINT=http://127.0.0.1:15081
#   COGNITION_WORLD_STATE_ENDPOINT=http://127.0.0.1:15073
#   COGNITION_TRACE_DIR=./trace/cognition
#   COGNITION_BUDGET_WALL_CLOCK_MS=8000  per-turn agent-loop wall-clock cap. Keep
#                                         it below the upstream budget forwarded
#                                         from runtime (GATEWAY_HTTP_REQUEST_TIMEOUT_MS
#                                         minus RUNTIME_LAYER_RESERVE_MS) to avoid a
#                                         layer inversion. Slow multi-step
#                                         deepseek-v4-flash turns need more than 8s.
#   COGNITION_BUDGET_MAX_STEPS=5
#   COGNITION_BUDGET_MAX_TOKENS=64000
#
# memory                         127.0.0.1:15071
#   MEMORY_LISTEN_ADDR=127.0.0.1:15071
#   MEMORY_LLM_GATEWAY_ENDPOINT=http://127.0.0.1:8081
#   MEMORY_TRACE_DIR=./trace/memory
#
# retrieval                      127.0.0.1:15081
#   RETRIEVAL_LISTEN_ADDR=127.0.0.1:15081
#   RETRIEVAL_LLM_GATEWAY_ENDPOINT=http://127.0.0.1:8081
#   RETRIEVAL_TRACE_DIR=./trace/retrieval
#   RETRIEVAL_EMBEDDING_MODEL=<required>  manifest-verification label (NOT the
#                                          routing key); written into the artifact
#                                          manifest at build time and checked at
#                                          load time. Empty aborts startup with
#                                          `invalid input: embedding_model`.
#   RETRIEVAL_EMBEDDING_ROLE=retrieval-embed  EmbedRequest.role routing key; the
#                                             gateway config must define this role
#                                             before `retrieval-index` can embed.
#
# world-state                    127.0.0.1:15073
#   WORLD_STATE_LISTEN_ADDR=127.0.0.1:15073
#
# Other paths (prompts/skills/artifact/dedup dirs) have per-crate defaults and
# are rarely overridden; see each crate's config.rs.

# --- Virtual Game tool (dev client) ------------------------------------------
# Gateway target.
VG_GATEWAY_BASE_URL=http://127.0.0.1:8080
VG_GATEWAY_AUTH_TOKEN=dev-token
VG_TRACE_DIR_GATEWAY=./trace/gateway

# Local file locations (repo-relative; use absolute paths if run from elsewhere).
VG_FIXTURES_DIR=./tools/virtual_game/fixtures
VG_REPORTS_DIR=./tools/virtual_game/reports
VG_RUNS_DIR=./tools/virtual_game/runs

# Web UI / batch knobs (defaults shown).
# VG_LISTEN_HOST=127.0.0.1
# VG_LISTEN_PORT=8750
# VG_BATCH_CONCURRENCY_LIMIT=4
# VG_REQUEST_TIMEOUT_MS=10000
